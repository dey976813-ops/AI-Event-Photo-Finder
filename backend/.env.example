# Server
PORT=5000
# Comma-separated development origins. The original Express app allowed all origins;
# this safer equivalent keeps the existing frontend origin and permits additions.
CORS_ORIGINS=http://localhost:3000

# Supabase (server-only secret; never expose this value to the browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key
# Compatibility fallback for projects using the older name:
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Compatibility fallback:
# SUPABASE_ANON_KEY=your-anon-key

# Existing FastAPI AI service, which exposes POST /embed
AI_SERVICE_URL=http://localhost:8000
